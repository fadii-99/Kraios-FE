# ---------------------------------------------------------------------------
# Browser-visible config (VITE_ prefix). Baked into the bundle at build time.
# ---------------------------------------------------------------------------
# The app always calls its OWN origin and is proxied to the backend from there:
#   development -> Vite server proxy (vite.config.js)
#   Vercel      -> /api/* rewrite -> api/proxy.js serverless function
# Keep this relative. An absolute backend URL breaks cookie auth.
VITE_API_BASE_URL=/api/v1

# ---------------------------------------------------------------------------
# Server-side only. NEVER prefixed with VITE_ — it must not reach the browser.
# ---------------------------------------------------------------------------
# Upstream Kraios API origin, scheme + host + port, no trailing slash and no
# /api suffix. Read by api/proxy.js on Vercel and by the Vite dev proxy.
# Set it in the Vercel project settings (Production + Preview) to move the
# backend without a code change.
BACKEND_ORIGIN=http://18.141.164.144:8000

# --- FloorPlan3D experiment (backend/floorplan3d/) --------------------------
# OFF by default. The BACKEND is the real gate: every endpoint under
# /api/v1/experiments/floorplan-3d/ answers 404 unless FLOORPLAN3D_ENABLED is
# True there. This flag only decides whether the routes and their (large,
# Three.js-carrying) lazy chunk exist in the client at all, so a production
# build with it unset ships neither.
#
# The experiment is deliberately absent from the dashboard sidebar; reach it at
# /dashboard/experiments/floorplan-3d.
VITE_FLOORPLAN3D_ENABLED=false
